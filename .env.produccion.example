# Copia esto a `.env` EN EL SERVIDOR (nunca lo subas al repositorio).
#
#   cp .env.produccion.example .env
#   nano .env
#
# Los dos secretos se generan, no se inventan:
#   DB_PASSWORD:  openssl rand -base64 24 | tr -d '/+='
#   JWT_SECRET:   openssl rand -base64 48

# El dominio que apunta a la IP de este servidor. Caddy saca el certificado para
# este nombre, así que tiene que resolver ANTES de levantar los contenedores.
# Para una prueba sin dominio, pon `:80` y accederás por HTTP a la IP pelada.
DOMINIO=api.tudominio.mx

DB_PASSWORD=
JWT_SECRET=

# Sin esta clave el servidor arranca igual: solo se desactiva /v1/ai/*, y el RAG
# sigue funcionando en modo léxico para el diario.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Correo saliente. Solo se usa para mandar el código de recuperación de
# contraseña; el servidor no manda ningún otro correo.
#
# Sin SMTP_HOST el servidor arranca igual, pero /v1/auth/password/* responde 503
# y quien olvide su contraseña pierde el diario. Para una app publicada esto es,
# en la práctica, obligatorio.
#
# Puerto: 587 usa STARTTLS y es lo que ofrece casi todo el mundo. 465 (TLS
# directo) también sirve; el código lo detecta por el número.
#
# Con Gmail hace falta una CONTRASEÑA DE APLICACIÓN, no la de la cuenta:
# myaccount.google.com → Seguridad → Verificación en dos pasos → Contraseñas de
# aplicaciones. La normal la rechaza el servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remitente. Si lo dejas vacío se usa SMTP_USER.
SMTP_FROM=
SMTP_FROM_NAME=Un Día Más
