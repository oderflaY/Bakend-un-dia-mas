# Copia a .env y ajusta. .env está en .gitignore: nunca lo subas.
ADDR=:8080
DATABASE_URL=postgres://undiamas:undiamas@localhost:5432/undiamas?sslmode=disable

# Genera uno con: openssl rand -base64 48
JWT_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Si se deja vacía, /v1/ai/* no se monta y el servidor arranca igual.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Modelo de embeddings del RAG. Se factura aparte del de chat. Si la llamada
# falla, la recuperación sigue funcionando solo con coincidencia de palabras.
EMBEDDING_MODEL=text-embedding-004

# Correo saliente, solo para el código de recuperación de contraseña. Si se deja
# vacío, /v1/auth/password/* responde 503 y el resto funciona igual.
# El código no se puede sacar de la base: ahí solo vive su hash bcrypt. Para
# probar el flujo en local, levanta un buzón de mentira que enseñe los correos
# en el navegador y apunta el SMTP ahí:
#   docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
# (Mailpit acepta STARTTLS, que es lo que el mailer exige fuera del puerto 465.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Un Día Más

# Solo para `make test-integration`. Cada test crea su propio esquema dentro de
# esta base y lo borra al terminar; sin esta variable los tests de integración se
# saltan en lugar de fallar.
# TEST_DATABASE_URL=postgres://undiamas:undiamas@localhost:5432/undiamas?sslmode=disable
