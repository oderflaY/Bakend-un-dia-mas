# Copia a .env y ajusta. .env está en .gitignore: nunca lo subas.
ADDR=:8080
DATABASE_URL=postgres://undiamas:undiamas@localhost:5432/undiamas?sslmode=disable

# Genera uno con: openssl rand -base64 48
JWT_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Si se deja vacía, /v1/ai/* no se monta y el servidor arranca igual.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Solo para `make test-integration`. Cada test crea su propio esquema dentro de
# esta base y lo borra al terminar; sin esta variable los tests de integración se
# saltan en lugar de fallar.
# TEST_DATABASE_URL=postgres://undiamas:undiamas@localhost:5432/undiamas?sslmode=disable
